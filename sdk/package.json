{
  "name": "@sdplatform/bolt-sdk",
  "version": "0.1.0",
  "description": "Event-driven SDK for Azure with voice-command integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/examples/app.js",
    "dev": "ts-node src/examples/app.ts",
    "demo": "ts-node -r dotenv/config src/examples/simple-demo.ts",
    "test": "jest",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "event-driven",
    "azure",
    "sdk",
    "voice-commands",
    "cognitive-services"
  ],
  "dependencies": {
    "@azure/event-hubs": "^5.12.0",
    "@azure/identity": "^4.0.0",
    "@azure/keyvault-secrets": "^4.8.0",
    "@azure/service-bus": "^7.9.0",
    "@supabase/supabase-js": "^2.39.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "microsoft-cognitiveservices-speech-sdk": "^1.34.0",
    "pino": "^8.16.0",
    "pino-pretty": "^10.3.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^5.59.11",
    "@typescript-eslint/parser": "^5.59.11",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4"
  }
}
