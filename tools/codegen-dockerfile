FROM alpine:3.18

# Install basic dependencies
RUN apk add --no-cache bash curl openjdk11-jre nodejs npm python3 py3-pip

# Install protoc and plugins - simplified; for production use specific versions
RUN apk add --no-cache protobuf protobuf-dev

# Install Go for protoc-gen-go
RUN apk add --no-cache go

# Install protoc plugins
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@latest && \
    go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@latest

# Install Python gRPC tools
RUN pip3 install grpcio grpcio-tools

# Install TypeScript protoc plugin
RUN npm install -g ts-proto

# Install OpenAPI generator
RUN npm install -g @openapitools/openapi-generator-cli

# Add Go bin to PATH
ENV PATH="/root/go/bin:${PATH}"

# Copy in scripts
WORKDIR /work
COPY ../proto ./proto
COPY ../openapi ./openapi
COPY ./build-codegen.sh .

RUN chmod +x ./build-codegen.sh

ENTRYPOINT ["/work/build-codegen.sh"]
